{
  "uid": "fulfillment",
  "title": "Order fulfillment",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Oldest unconfirmed order (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "fulfillment_oldest_pending_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Warehouse results per second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (warehouse,outcome) (rate(fulfillment_warehouse_results_total[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "API P99 (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{instance=\"api:8080\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Database connections waiting",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "hikaricp_connections_pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Warehouse circuit state (0 closed, 1 open, 2 half-open)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "fulfillment_warehouse_circuit_state",
          "refId": "A",
          "legendFormat": "{{instance}} {{warehouse}} {{operation}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Denied warehouse admission checks per second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(fulfillment_warehouse_circuit_denied_total[2m])",
          "refId": "A",
          "legendFormat": "{{instance}} {{warehouse}} {{operation}}"
        }
      ]
    }
  ]
}
